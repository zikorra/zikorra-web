# Vercel production is indexable automatically; previews are always noindex.
# For a non-Vercel PRODUCTION build only, explicitly set true.
# Leave unset or false on staging/local builds. Rebuild after changing.
# SEO_ALLOW_INDEXING=false

# Optional Google Search Console HTML verification token (public, not a secret).
# GOOGLE_SITE_VERIFICATION=replace-with-your-verification-token
